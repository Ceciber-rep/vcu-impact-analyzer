# Copy to .env and fill in. Never commit .env (it is git-ignored).
#
# --- Model used by the application -----------------------------------------
# LLM_PROVIDER: github | gemini | groq | cerebras | mistral | ollama | openai_compatible
LLM_PROVIDER=
LLM_MODEL=
# Optional: overrides the provider's default endpoint (required for openai_compatible).
LLM_BASE_URL=
# Optional: if empty, the provider-specific key below is used.
LLM_API_KEY=

# --- Provider keys (only the ones you use; also used by eval/) -------------
# GitHub Models: fine-grained personal access token with "Models: read" permission
GITHUB_TOKEN=
# Google AI Studio
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
