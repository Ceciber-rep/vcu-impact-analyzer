# Copy to .env and fill in the key(s). Never commit .env (it is git-ignored).
# Without any key the app still works in replay mode (recorded analyses).
#
# --- Primary model (chosen after the evaluation, see docs/llm_evaluation.md) ---
# LLM_PROVIDER: groq | gemini | cerebras | mistral | ollama | openai_compatible
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
# Optional: overrides the provider's default endpoint (required for openai_compatible).
LLM_BASE_URL=
# Optional: if empty, the provider-specific key below is used.
LLM_API_KEY=

# --- Optional fallback, used once if the primary fails (rate limit, outage) ---
LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-3.5-flash
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# --- Provider keys (only the ones you use) -----------------------------------
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Other OpenAI-compatible providers supported by the client:
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# --- Optional tuning ------------------------------------------------------------
# LLM_TIMEOUT_S=600
# LLM_MAX_TOKENS=16384
